{
  "name": "VerifyObservation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "enrolment_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "observer_id": {
      "type": "string"
    },
    "observer_name": {
      "type": "string"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "result": {
      "type": "string",
      "enum": [
        "Signed off",
        "Repeat"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "default": "Signed off"
    },
    "lines_to_work_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "signed_at": {
      "type": "string"
    }
  },
  "required": [
    "enrolment_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.observer_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.site_id": "{{user.data.site_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}