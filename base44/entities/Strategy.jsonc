{
  "name": "Strategy",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "objective_code": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "success_metric": {
      "type": "string"
    },
    "value_volume": {
      "type": "string"
    },
    "value_dollars": {
      "type": "string"
    },
    "deliver_date": {
      "type": "string",
      "format": "date"
    },
    "deliver_month": {
      "type": "string"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_date": {
      "type": "string"
    },
    "sort": {
      "type": "number",
      "default": 0
    },
    "is_test": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code",
    "statement"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}