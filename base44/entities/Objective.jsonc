{
  "name": "Objective",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "value_to_business": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "target_date": {
      "type": "string"
    },
    "exec_owner": {
      "type": "string"
    },
    "load_bearing_note": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "sort": {
      "type": "number",
      "default": 0
    },
    "is_test": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code",
    "statement"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}