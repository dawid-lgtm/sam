{
  "name": "OpsEnrolment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "cohort_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "superintendent_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Prime",
        "Lab",
        "Apply",
        "Verify",
        "Complete"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "purple",
        "green"
      ],
      "default": "Prime"
    },
    "prime_started": {
      "type": "string",
      "format": "date"
    },
    "lab_completed_at": {
      "type": "string"
    },
    "lab_completed_by": {
      "type": "string"
    },
    "apply_start": {
      "type": "string",
      "format": "date"
    },
    "apply_end": {
      "type": "string",
      "format": "date"
    },
    "verify_date": {
      "type": "string",
      "format": "date"
    },
    "verify_result": {
      "type": "string",
      "enum": [
        "Not yet",
        "Signed off",
        "Repeat"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow"
      ],
      "default": "Not yet"
    },
    "first_shift_commitment": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.site_id": "{{user.data.site_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}