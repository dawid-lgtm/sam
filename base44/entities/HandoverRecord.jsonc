{
  "name": "HandoverRecord",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "In",
        "Out"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "In"
    },
    "counterpart_name": {
      "type": "string"
    },
    "pava_rows": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "setup_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Done",
        "Missed"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow"
      ],
      "default": "Draft"
    },
    "submitted_at": {
      "type": "string"
    },
    "skipped_reason": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "direction"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.site_id": "{{user.data.site_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}