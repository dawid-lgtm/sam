{
  "name": "PrimeResponse",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "enrolment_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "task_no": {
      "type": "number"
    },
    "answers": {
      "type": "object",
      "default": {}
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "submitted_at": {
      "type": "string"
    }
  },
  "required": [
    "enrolment_id",
    "task_no"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.site_id": "{{user.data.site_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}