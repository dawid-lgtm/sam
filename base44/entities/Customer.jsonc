{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Prospect",
        "Onboarding",
        "Active",
        "Paused"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red"
      ],
      "default": "Prospect"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "progress_sam": {
      "type": "number",
      "default": 0
    },
    "progress_ops": {
      "type": "number",
      "default": 0
    },
    "progress_maintenance": {
      "type": "number",
      "default": 0
    },
    "progress_strategy": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}