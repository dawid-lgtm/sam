{
  "name": "Site",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Open pit",
        "Underground"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "superintendent": {
      "type": "string"
    },
    "sort": {
      "type": "number",
      "default": 0
    },
    "is_test": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}