{
  "name": "Tool",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Handbook",
        "Agenda",
        "Coaching card",
        "Workbook",
        "Slide pack",
        "Other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "pink",
        "gray"
      ],
      "default": "Handbook"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "v1"
    },
    "assigned_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}